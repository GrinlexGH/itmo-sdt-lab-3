{
  "name": "c-complexity",
  "displayName": "C/C++ Cyclomatic Complexity",
  "description": "Shows cyclomatic complexity and line count above each C/C++ function and warns when thresholds are exceeded",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [],
    "configuration": {
      "title": "C/C++ Cyclomatic Complexity",
      "properties": {
        "cComplexity.threshold": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Cyclomatic complexity above which a function gets a warning."
        },
        "cComplexity.maxLines": {
          "type": "number",
          "default": 50,
          "minimum": 1,
          "description": "Function length (lines) above which a function gets a warning."
        },
        "cComplexity.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show metrics above each function."
        },
        "cComplexity.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Report threshold violations in the Problems panel."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
